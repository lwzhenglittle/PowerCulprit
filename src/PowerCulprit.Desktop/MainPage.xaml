<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="PowerCulprit.Desktop.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:PowerCulprit.Desktop.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:PowerCulprit.Desktop.ViewModels"
    mc:Ignorable="d">

    <!-- Keep the default NavigationCacheMode=Disabled. The Win2D chart calls
         RemoveFromVisualTree when unloaded and cannot be reused from a cached page. -->

    <Page.Resources>
        <vm:BoolToInverseConverter x:Key="BoolToInverseConverter" />
        <vm:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <vm:StatusToBrushConverter x:Key="StatusToBrushConverter" />
        <vm:StringToVisibilityConverter x:Key="StringToVisibilityConverter" />
    </Page.Resources>

    <ScrollViewer x:Name="RootScrollViewer"
                  Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
                  HorizontalContentAlignment="Stretch"
                  HorizontalScrollMode="Disabled"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="WindowWidthStates">
                <VisualState x:Name="WideLayout">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1000" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="SourcesColumn.Width" Value="360" />
                        <Setter Target="HistoryCard.(Grid.Row)" Value="0" />
                        <Setter Target="HistoryCard.(Grid.Column)" Value="0" />
                        <Setter Target="SourcesPanel.(Grid.Row)" Value="0" />
                        <Setter Target="SourcesPanel.(Grid.Column)" Value="1" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="CompactLayout">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="SourcesColumn.Width" Value="0" />
                        <Setter Target="HistoryCard.(Grid.Row)" Value="0" />
                        <Setter Target="HistoryCard.(Grid.Column)" Value="0" />
                        <Setter Target="SourcesPanel.(Grid.Row)" Value="1" />
                        <Setter Target="SourcesPanel.(Grid.Column)" Value="0" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <StackPanel Padding="{StaticResource PageContentMargin}"
                    Spacing="16"
                    Width="{x:Bind RootScrollViewer.ViewportWidth, Mode=OneWay}">

            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Spacing="4">
                    <TextBlock Text="PowerCulprit"
                               Style="{StaticResource DashboardTitleTextBlockStyle}" />
                    <TextBlock Text="Battery drain analysis dashboard — correlation-based attribution, not a per-process wattmeter"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="{x:Bind ViewModel.LastSampleTimeText, Mode=OneWay}"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="8"
                            VerticalAlignment="Center">
                    <Border Style="{StaticResource StatusPillBorderStyle}"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="Sampling"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.SamplingStatusText, Mode=OneWay}"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>

                    <Button Command="{x:Bind ViewModel.StartMonitoringCommand}"
                            IsEnabled="{x:Bind ViewModel.IsRunning, Mode=OneWay, Converter={StaticResource BoolToInverseConverter}}"
                            Style="{StaticResource AccentButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon FontSize="14" Glyph="&#xE768;" />
                            <TextBlock Text="Start" />
                        </StackPanel>
                    </Button>

                    <Button Command="{x:Bind ViewModel.StopMonitoringCommand}"
                            IsEnabled="{x:Bind ViewModel.IsRunning, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon FontSize="14" Glyph="&#xE71A;" />
                            <TextBlock Text="Stop" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <Border Style="{StaticResource DashboardCardStyle}"
                    Padding="8">
                <CommandBar Background="Transparent"
                            DefaultLabelPosition="Right"
                            IsDynamicOverflowEnabled="True">
                    <AppBarButton Command="{x:Bind ViewModel.RefreshHistoryCommand}"
                                  IsEnabled="{x:Bind ViewModel.IsHistoryLoading, Mode=OneWay, Converter={StaticResource BoolToInverseConverter}}"
                                  Label="Refresh">
                        <AppBarButton.Icon>
                            <SymbolIcon Symbol="Refresh" />
                        </AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarButton Command="{x:Bind ViewModel.LatestCycleCommand}"
                                  IsEnabled="{x:Bind ViewModel.IsHistoryLoading, Mode=OneWay, Converter={StaticResource BoolToInverseConverter}}"
                                  Label="Latest Cycle">
                        <AppBarButton.Icon>
                            <SymbolIcon Symbol="Calendar" />
                        </AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarButton Command="{x:Bind ViewModel.Last6HoursCommand}"
                                  IsEnabled="{x:Bind ViewModel.IsHistoryLoading, Mode=OneWay, Converter={StaticResource BoolToInverseConverter}}"
                                  Label="Last 6h">
                        <AppBarButton.Icon>
                            <SymbolIcon Symbol="Clock" />
                        </AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarButton Command="{x:Bind ViewModel.ExportCsvCommand}"
                                  Label="Export CSV">
                        <AppBarButton.Icon>
                            <SymbolIcon Symbol="Download" />
                        </AppBarButton.Icon>
                    </AppBarButton>

                    <CommandBar.Content>
                        <StackPanel Orientation="Horizontal"
                                    Spacing="16"
                                    VerticalAlignment="Center">
                            <ProgressRing Width="18"
                                          Height="18"
                                          IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                                          Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                          ToolTipService.ToolTip="Loading or analyzing..." />
                            <ToggleSwitch Header="GPU Engine"
                                          IsOn="{x:Bind ViewModel.IsGpuSamplingEnabled, Mode=TwoWay}"
                                          OffContent="Off"
                                          OnContent="On" />
                            <InfoBar IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                                     IsClosable="False"
                                     Severity="Error"
                                     Message="{x:Bind ViewModel.ErrorText, Mode=OneWay}"
                                     MaxWidth="520" />
                        </StackPanel>
                    </CommandBar.Content>

                    <CommandBar.SecondaryCommands>
                        <AppBarButton Click="ClearHistoryButton_Click"
                                      IsEnabled="{x:Bind ViewModel.IsHistoryLoading, Mode=OneWay, Converter={StaticResource BoolToInverseConverter}}"
                                      Label="Clear History">
                            <AppBarButton.Icon>
                                <SymbolIcon Symbol="Delete" />
                            </AppBarButton.Icon>
                        </AppBarButton>
                    </CommandBar.SecondaryCommands>
                </CommandBar>
            </Border>

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0.7*" />
                    <ColumnDefinition Width="1.35*" />
                    <ColumnDefinition Width="1.6*" />
                    <ColumnDefinition Width="1.75*" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource DashboardCompactCardStyle}">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Power source"
                                   Style="{StaticResource MetricLabelTextBlockStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.AcStatusText, Mode=OneWay}"
                                   Style="{StaticResource MetricValueTextBlockStyle}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1"
                        Style="{StaticResource DashboardCompactCardStyle}">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Battery now"
                                   Style="{StaticResource MetricLabelTextBlockStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.CurrentBatteryPercentText, Mode=OneWay}"
                                   Style="{StaticResource MetricValueTextBlockStyle}"
                                   ToolTipService.ToolTip="Latest live battery percentage" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2"
                        Style="{StaticResource DashboardCompactCardStyle}">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Live power split (30 s)"
                                   Style="{StaticResource MetricLabelTextBlockStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.CurrentPowerBreakdownTotalText, Mode=OneWay}"
                                   Style="{StaticResource MetricValueTextBlockStyle}"
                                   ToolTipService.ToolTip="Time-weighted whole-system discharge measured at the battery" />
                        <ProgressBar Minimum="0"
                                     Maximum="100"
                                     Value="{x:Bind ViewModel.CurrentCpuSharePercent, Mode=OneWay}"
                                     Height="8"
                                     ToolTipService.ToolTip="Filled portion is CPU package share; the track remainder is non-CPU residual" />
                        <Grid RowSpacing="2" ColumnSpacing="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="CPU package"
                                       Style="{StaticResource MetricLabelTextBlockStyle}"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1"
                                       Text="{x:Bind ViewModel.CurrentCpuShareText, Mode=OneWay}"
                                       Style="{StaticResource MetricValueTextBlockStyle}"
                                       HorizontalAlignment="Right"
                                       ToolTipService.ToolTip="CPU package divided by whole-system battery discharge over the same time window" />
                            <TextBlock Grid.Row="1"
                                       Text="Non-CPU residual"
                                       Style="{StaticResource MetricLabelTextBlockStyle}"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Row="1"
                                       Grid.Column="1"
                                       Text="{x:Bind ViewModel.CurrentNonCpuShareText, Mode=OneWay}"
                                       Style="{StaticResource MetricValueTextBlockStyle}"
                                       HorizontalAlignment="Right"
                                       ToolTipService.ToolTip="Battery discharge minus CPU package. Includes display, storage, radios, fans, conversion losses and measurement error; it is not a direct peripheral measurement" />
                        </Grid>
                        <TextBlock Text="{x:Bind ViewModel.CurrentPowerBreakdownStatusText, Mode=OneWay}"
                                   TextWrapping="Wrap"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Expander Header="Instantaneous overlapping domains"
                                  HorizontalAlignment="Stretch">
                            <Grid RowSpacing="2" ColumnSpacing="8" Margin="0,4,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="CPU package" Style="{StaticResource MetricLabelTextBlockStyle}" />
                                <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.CurrentCpuPackagePowerText, Mode=OneWay}" HorizontalAlignment="Right" />
                                <TextBlock Grid.Row="1" Text="CPU cores" Style="{StaticResource MetricLabelTextBlockStyle}" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind ViewModel.CurrentCpuCoresPowerText, Mode=OneWay}" HorizontalAlignment="Right" />
                                <TextBlock Grid.Row="2" Text="CPU memory" Style="{StaticResource MetricLabelTextBlockStyle}" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{x:Bind ViewModel.CurrentCpuMemoryPowerText, Mode=OneWay}" HorizontalAlignment="Right" />
                                <TextBlock Grid.Row="3" Text="CPU platform" Style="{StaticResource MetricLabelTextBlockStyle}" />
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{x:Bind ViewModel.CurrentCpuPlatformPowerText, Mode=OneWay}" HorizontalAlignment="Right" />
                                <TextBlock Grid.Row="4" Text="GPU" Style="{StaticResource MetricLabelTextBlockStyle}" />
                                <TextBlock Grid.Row="4" Grid.Column="1" Text="{x:Bind ViewModel.CurrentGpuPowerText, Mode=OneWay}" HorizontalAlignment="Right" />
                            </Grid>
                        </Expander>
                    </StackPanel>
                </Border>

                <Border Grid.Column="3"
                        Style="{StaticResource DashboardCompactCardStyle}">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Battery energy used"
                                   Style="{StaticResource MetricLabelTextBlockStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.DischargeRateText, Mode=OneWay}"
                                   Style="{StaticResource MetricValueTextBlockStyle}"
                                   ToolTipService.ToolTip="Selected historical range energy" />
                    </StackPanel>
                </Border>
            </Grid>

            <Grid x:Name="HistoryAndSourcesGrid"
                  ColumnSpacing="16"
                  RowSpacing="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition x:Name="SourcesColumn" Width="360" />
                </Grid.ColumnDefinitions>

                <Border x:Name="HistoryCard"
                        Style="{StaticResource DashboardCardStyle}">
                    <Grid RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="360" />
                        </Grid.RowDefinitions>

                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Battery history"
                                       Style="{StaticResource SectionTitleTextBlockStyle}" />
                            <Button Grid.Column="1"
                                    Content="Reset zoom"
                                    Click="HistoryChart_ResetZoom_Click"
                                    Padding="10,4"
                                    MinHeight="28" />
                            <TextBlock Grid.Column="2"
                                       Text="{x:Bind ViewModel.HistoryStatusText, Mode=OneWay}"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       MaxWidth="280"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Top" />
                        </Grid>

                        <controls:PowerHistoryChart x:Name="HistoryChart"
                                                    Grid.Row="1"
                                                    DischargeAxisMax="{x:Bind ViewModel.ChartDischargeAxisMax, Mode=OneWay}"
                                                    HistoryFromUtc="{x:Bind ViewModel.ChartHistoryFromUtc, Mode=OneWay}"
                                                    HistoryToUtc="{x:Bind ViewModel.ChartHistoryToUtc, Mode=OneWay}"
                                                    PointerEntered="HistoryChart_PointerEntered"
                                                    PointerExited="HistoryChart_PointerExited"
                                                    Samples="{x:Bind ViewModel.ChartSamples, Mode=OneWay}"
                                                    Unloaded="HistoryChart_Unloaded"
                                                    VisibleFromUtc="{x:Bind ViewModel.ChartVisibleFromUtc, Mode=OneWay}"
                                                    VisibleRangeChanged="HistoryChart_VisibleRangeChanged"
                                                    VisibleToUtc="{x:Bind ViewModel.ChartVisibleToUtc, Mode=OneWay}" />
                    </Grid>
                </Border>

                <StackPanel x:Name="SourcesPanel"
                            Grid.Column="1"
                            Spacing="16">
                    <Border Style="{StaticResource DashboardCardStyle}">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Cycle"
                                       Style="{StaticResource SectionTitleTextBlockStyle}" />
                            <ComboBox HorizontalAlignment="Stretch"
                                      DisplayMemberPath="Label"
                                      ItemsSource="{x:Bind ViewModel.CycleRows, Mode=OneWay}"
                                      PlaceholderText="No cycles"
                                      SelectedItem="{x:Bind ViewModel.SelectedCycleRow, Mode=TwoWay}" />
                            <TextBlock Text="{x:Bind ViewModel.CycleStatusText, Mode=OneWay}"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTipService.ToolTip="{x:Bind ViewModel.CycleStatusText, Mode=OneWay}" />
                            <TextBlock Text="{x:Bind ViewModel.AnalysisStatusText, Mode=OneWay}"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTipService.ToolTip="{x:Bind ViewModel.AnalysisStatusText, Mode=OneWay}" />
                            <TextBlock Text="{x:Bind ViewModel.ExcludedIntervalsSummary, Mode=OneWay}"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource SystemFillColorAttentionBrush}"
                                       TextWrapping="Wrap"
                                       Visibility="{x:Bind ViewModel.ExcludedIntervalsSummary, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource DashboardCardStyle}">
                        <Grid RowSpacing="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Text="Data sources"
                                       Style="{StaticResource SectionTitleTextBlockStyle}" />

                            <ListView Grid.Row="1"
                                      MaxHeight="210"
                                      ItemsSource="{x:Bind ViewModel.SourceStatusRows, Mode=OneWay}"
                                      SelectionMode="None">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="Margin" Value="0,0,0,2" />
                                        <Setter Property="MinHeight" Value="0" />
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Height" Value="54" />
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnSpacing="8" Padding="4,5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="10" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Ellipse Width="8"
                                                     Height="8"
                                                     Fill="{Binding Status, Converter={StaticResource StatusToBrushConverter}}"
                                                     VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding SourceName}"
                                                           Style="{StaticResource TableCellTextBlockStyle}" />
                                                <TextBlock Text="{Binding Details}"
                                                           Style="{StaticResource CaptionTextBlockStyle}"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTipService.ToolTip="{Binding Details}" />
                                            </StackPanel>
                                            <Border Grid.Column="2"
                                                    Style="{StaticResource StatusPillBorderStyle}"
                                                    VerticalAlignment="Top">
                                                <TextBlock Text="{Binding Status}"
                                                           Style="{StaticResource CaptionTextBlockStyle}"
                                                           Foreground="{Binding Status, Converter={StaticResource StatusToBrushConverter}}" />
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Border>
                </StackPanel>
            </Grid>

            <Border Style="{StaticResource DashboardCardStyle}">
                <Grid RowSpacing="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="320" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="Top 20 processes"
                               Style="{StaticResource SectionTitleTextBlockStyle}" />

                    <Border Grid.Row="1"
                            Style="{StaticResource TableHeaderBorderStyle}">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="44" />
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="72" />
                                <ColumnDefinition Width="72" />
                                <ColumnDefinition Width="72" />
                                <ColumnDefinition Width="72" />
                                <ColumnDefinition Width="72" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="76" />
                                <ColumnDefinition Width="76" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Rank" Style="{StaticResource TableHeaderTextBlockStyle}" />
                            <TextBlock Grid.Column="1" Text="Name" Style="{StaticResource TableHeaderTextBlockStyle}" />
                            <TextBlock Grid.Column="2"
                                       Text="Score"
                                       HorizontalAlignment="Right"
                                       Style="{StaticResource TableHeaderTextBlockStyle}"
                                       ToolTipService.ToolTip="Heuristic correlation score (not watts) — ranks how strongly each process's activity tracks the battery discharge curve in the selected range" />
                            <TextBlock Grid.Column="3" Text="Avg CPU" HorizontalAlignment="Right" Style="{StaticResource TableHeaderTextBlockStyle}" />
                            <TextBlock Grid.Column="4" Text="Max CPU" HorizontalAlignment="Right" Style="{StaticResource TableHeaderTextBlockStyle}" />
                            <TextBlock Grid.Column="5" Text="Avg GPU" HorizontalAlignment="Right" Style="{StaticResource TableHeaderTextBlockStyle}" />
                            <TextBlock Grid.Column="6" Text="Max GPU" HorizontalAlignment="Right" Style="{StaticResource TableHeaderTextBlockStyle}" />
                            <TextBlock Grid.Column="7" Text="Disk MB" HorizontalAlignment="Right" Style="{StaticResource TableHeaderTextBlockStyle}" />
                            <TextBlock Grid.Column="8"
                                       Text="FG min"
                                       HorizontalAlignment="Right"
                                       Style="{StaticResource TableHeaderTextBlockStyle}"
                                       ToolTipService.ToolTip="Foreground minutes - samples x sampling interval; sub-interval window flicker not reflected" />
                            <TextBlock Grid.Column="9"
                                       Text="BG min"
                                       HorizontalAlignment="Right"
                                       Style="{StaticResource TableHeaderTextBlockStyle}"
                                       ToolTipService.ToolTip="Background minutes - samples x sampling interval; sub-interval window flicker not reflected" />
                            <TextBlock Grid.Column="10" Text="Reason" Style="{StaticResource TableHeaderTextBlockStyle}" />
                        </Grid>
                    </Border>

                    <Grid Grid.Row="2">
                        <ListView ItemsSource="{x:Bind ViewModel.ProcessRows, Mode=OneWay}"
                                  SelectionMode="None"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0" />
                                <Setter Property="MinHeight" Value="0" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Height" Value="36" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="0,0,0,1">
                                    <Grid ColumnSpacing="8" Padding="{StaticResource TableCellPadding}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="44" />
                                            <ColumnDefinition Width="180" />
                                            <ColumnDefinition Width="72" />
                                            <ColumnDefinition Width="72" />
                                            <ColumnDefinition Width="72" />
                                            <ColumnDefinition Width="72" />
                                            <ColumnDefinition Width="72" />
                                            <ColumnDefinition Width="80" />
                                            <ColumnDefinition Width="76" />
                                            <ColumnDefinition Width="76" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Rank}" Style="{StaticResource TableCellTextBlockStyle}" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding ProcessName}"
                                                   Style="{StaticResource TableCellTextBlockStyle}"
                                                   ToolTipService.ToolTip="{Binding ProcessName}" />
                                        <TextBlock Grid.Column="2" Text="{Binding ScoreText}" HorizontalAlignment="Right" Style="{StaticResource TableCellTextBlockStyle}" />
                                        <TextBlock Grid.Column="3" Text="{Binding AvgCpuText}" HorizontalAlignment="Right" Style="{StaticResource TableCellTextBlockStyle}" />
                                        <TextBlock Grid.Column="4" Text="{Binding MaxCpuText}" HorizontalAlignment="Right" Style="{StaticResource TableCellTextBlockStyle}" />
                                        <TextBlock Grid.Column="5" Text="{Binding AvgGpuText}" HorizontalAlignment="Right" Style="{StaticResource TableCellTextBlockStyle}" />
                                        <TextBlock Grid.Column="6" Text="{Binding MaxGpuText}" HorizontalAlignment="Right" Style="{StaticResource TableCellTextBlockStyle}" />
                                        <TextBlock Grid.Column="7" Text="{Binding DiskMbText}" HorizontalAlignment="Right" Style="{StaticResource TableCellTextBlockStyle}" />
                                        <TextBlock Grid.Column="8" Text="{Binding ForegroundMinutesText}" HorizontalAlignment="Right" Style="{StaticResource TableCellTextBlockStyle}" />
                                        <TextBlock Grid.Column="9" Text="{Binding BackgroundMinutesText}" HorizontalAlignment="Right" Style="{StaticResource TableCellTextBlockStyle}" />
                                        <TextBlock Grid.Column="10"
                                                   Text="{Binding ReasonText}"
                                                   Style="{StaticResource TableCellTextBlockStyle}"
                                                   ToolTipService.ToolTip="{Binding ReasonText}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                        </ListView>
                        <TextBlock Text="No process attribution in the selected range."
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Visibility="{x:Bind ViewModel.HasProcessRows, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}" />
                    </Grid>
                </Grid>
            </Border>

            <Border Style="{StaticResource DashboardCardStyle}">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="260" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="Launch attribution"
                               Style="{StaticResource SectionTitleTextBlockStyle}" />
                    <TextBlock Grid.Row="1"
                               Text="Observed ETW parent-child launches. Power delta compares conservative windows before and after each launch; it is evidence, not direct per-process watts."
                               TextWrapping="Wrap"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                    <Border Grid.Row="2"
                            Style="{StaticResource TableHeaderBorderStyle}">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="60" />
                                <ColumnDefinition Width="60" />
                                <ColumnDefinition Width="60" />
                                <ColumnDefinition Width="86" />
                                <ColumnDefinition Width="76" />
                                <ColumnDefinition Width="82" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Launcher" Style="{StaticResource TableHeaderTextBlockStyle}" />
                            <TextBlock Grid.Column="1" Text="Started" Style="{StaticResource TableHeaderTextBlockStyle}" />
                            <TextBlock Grid.Column="2" Text="Starts" HorizontalAlignment="Right" Style="{StaticResource TableHeaderTextBlockStyle}" />
                            <TextBlock Grid.Column="3" Text="Short" HorizontalAlignment="Right" Style="{StaticResource TableHeaderTextBlockStyle}" />
                            <TextBlock Grid.Column="4" Text="Desc." HorizontalAlignment="Right" Style="{StaticResource TableHeaderTextBlockStyle}" />
                            <TextBlock Grid.Column="5" Text="Median life" HorizontalAlignment="Right" Style="{StaticResource TableHeaderTextBlockStyle}" />
                            <TextBlock Grid.Column="6" Text="Power delta" HorizontalAlignment="Right" Style="{StaticResource TableHeaderTextBlockStyle}" />
                            <TextBlock Grid.Column="7" Text="Confidence" Style="{StaticResource TableHeaderTextBlockStyle}" />
                            <TextBlock Grid.Column="8" Text="Evidence" Style="{StaticResource TableHeaderTextBlockStyle}" />
                        </Grid>
                    </Border>

                    <Grid Grid.Row="3">
                        <ListView ItemsSource="{x:Bind ViewModel.LaunchInsightRows, Mode=OneWay}"
                                  SelectionMode="None"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0" />
                                    <Setter Property="MinHeight" Value="0" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Height" Value="40" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="0,0,0,1">
                                        <Grid ColumnSpacing="8" Padding="{StaticResource TableCellPadding}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="150" />
                                                <ColumnDefinition Width="150" />
                                                <ColumnDefinition Width="60" />
                                                <ColumnDefinition Width="60" />
                                                <ColumnDefinition Width="60" />
                                                <ColumnDefinition Width="86" />
                                                <ColumnDefinition Width="76" />
                                                <ColumnDefinition Width="82" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding LauncherProcessName}" Style="{StaticResource TableCellTextBlockStyle}" ToolTipService.ToolTip="{Binding LauncherProcessName}" />
                                            <TextBlock Grid.Column="1" Text="{Binding LaunchedProcessName}" Style="{StaticResource TableCellTextBlockStyle}" ToolTipService.ToolTip="{Binding LaunchedProcessName}" />
                                            <TextBlock Grid.Column="2" Text="{Binding LaunchCountText}" HorizontalAlignment="Right" Style="{StaticResource TableCellTextBlockStyle}" />
                                            <TextBlock Grid.Column="3" Text="{Binding ShortLivedCountText}" HorizontalAlignment="Right" Style="{StaticResource TableCellTextBlockStyle}" />
                                            <TextBlock Grid.Column="4" Text="{Binding DescendantCountText}" HorizontalAlignment="Right" Style="{StaticResource TableCellTextBlockStyle}" />
                                            <TextBlock Grid.Column="5" Text="{Binding MedianLifetimeText}" HorizontalAlignment="Right" Style="{StaticResource TableCellTextBlockStyle}" />
                                            <TextBlock Grid.Column="6" Text="{Binding PowerDeltaText}" HorizontalAlignment="Right" Style="{StaticResource TableCellTextBlockStyle}" />
                                            <TextBlock Grid.Column="7" Text="{Binding ConfidenceText}" Style="{StaticResource TableCellTextBlockStyle}" />
                                            <TextBlock Grid.Column="8" Text="{Binding EvidenceText}" Style="{StaticResource TableCellTextBlockStyle}" ToolTipService.ToolTip="{Binding EvidenceText}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <TextBlock Text="No process launch evidence in this range. Lifecycle history is available only after this version starts monitoring."
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Visibility="{x:Bind ViewModel.HasLaunchInsightRows, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}" />
                    </Grid>
                </Grid>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
