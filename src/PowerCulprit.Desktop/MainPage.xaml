<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="PowerCulprit.Desktop.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:lvc="using:LiveChartsCore.SkiaSharpView.WinUI"
    xmlns:vm="using:PowerCulprit.Desktop.ViewModels"
    mc:Ignorable="d">

    <Page.Resources>
        <vm:BoolToInverseConverter x:Key="BoolToInverseConverter" />
        <vm:StatusToBrushConverter x:Key="StatusToBrushConverter" />
    </Page.Resources>

    <ScrollViewer x:Name="RootScrollViewer"
                  VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="16" Spacing="12">

            <TextBlock Text="PowerCulprit" Style="{StaticResource TitleTextBlockStyle}" />

            <Border Background="{ThemeResource CardBackgroundFillColorDefault}"
                    CornerRadius="8" Padding="12">
                <Grid ColumnSpacing="18" RowSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="AC:" Foreground="{ThemeResource TextFillColorSecondary}" />
                        <TextBlock Text="{x:Bind ViewModel.AcStatusText, Mode=OneWay}" FontWeight="SemiBold" />
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="Battery:" Foreground="{ThemeResource TextFillColorSecondary}" />
                        <TextBlock Text="{x:Bind ViewModel.BatteryPercentText, Mode=OneWay}" FontWeight="SemiBold" />
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="Discharge:" Foreground="{ThemeResource TextFillColorSecondary}" />
                        <TextBlock Text="{x:Bind ViewModel.DischargeRateText, Mode=OneWay}" FontWeight="SemiBold" />
                    </StackPanel>

                    <TextBlock Grid.Row="0" Grid.Column="3"
                               Text="{x:Bind ViewModel.SelectedRangeText, Mode=OneWay}"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" />

                    <TextBlock Grid.Row="0" Grid.Column="4"
                               Text="{x:Bind ViewModel.SamplingStatusText, Mode=OneWay}"
                               VerticalAlignment="Center" />

                    <StackPanel Grid.Row="0" Grid.Column="5" Orientation="Horizontal" Spacing="8">
                        <Button Content="Start"
                                Command="{x:Bind ViewModel.StartMonitoringCommand}"
                                IsEnabled="{x:Bind ViewModel.IsRunning, Mode=OneWay, Converter={StaticResource BoolToInverseConverter}}" />
                        <Button Content="Stop"
                                Command="{x:Bind ViewModel.StopMonitoringCommand}"
                                IsEnabled="{x:Bind ViewModel.IsRunning, Mode=OneWay}" />
                        <Button Content="Refresh"
                                Command="{x:Bind ViewModel.RefreshHistoryCommand}"
                                IsEnabled="{x:Bind ViewModel.IsHistoryLoading, Mode=OneWay, Converter={StaticResource BoolToInverseConverter}}" />
                        <Button Content="Latest Cycle"
                                Command="{x:Bind ViewModel.LatestCycleCommand}"
                                IsEnabled="{x:Bind ViewModel.IsHistoryLoading, Mode=OneWay, Converter={StaticResource BoolToInverseConverter}}" />
                        <Button Content="Last 6h"
                                Command="{x:Bind ViewModel.Last6HoursCommand}"
                                IsEnabled="{x:Bind ViewModel.IsHistoryLoading, Mode=OneWay, Converter={StaticResource BoolToInverseConverter}}" />
                        <Button Content="Export CSV"
                                Command="{x:Bind ViewModel.ExportCsvCommand}" />
                        <Button Content="Clear History"
                                Click="ClearHistoryButton_Click"
                                IsEnabled="{x:Bind ViewModel.IsHistoryLoading, Mode=OneWay, Converter={StaticResource BoolToInverseConverter}}" />
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="6"
                                Orientation="Horizontal" Spacing="16">
                        <ComboBox Width="380"
                                  ItemsSource="{x:Bind ViewModel.CycleRows, Mode=OneWay}"
                                  SelectedItem="{x:Bind ViewModel.SelectedCycleRow, Mode=TwoWay}"
                                  DisplayMemberPath="Label"
                                  PlaceholderText="No cycles" />
                        <TextBlock Text="{x:Bind ViewModel.CycleStatusText, Mode=OneWay}"
                                   Width="420"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{ThemeResource TextFillColorSecondary}" />
                        <TextBlock Text="{x:Bind ViewModel.HistoryStatusText, Mode=OneWay}"
                                   Foreground="{ThemeResource TextFillColorSecondary}" />
                        <TextBlock Text="{x:Bind ViewModel.AnalysisStatusText, Mode=OneWay}"
                                   Foreground="{ThemeResource TextFillColorSecondary}" />
                        <TextBlock Text="{x:Bind ViewModel.ErrorText, Mode=OneWay}"
                                   Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                        <ToggleSwitch Header="GPU Engine"
                                      IsOn="{x:Bind ViewModel.IsGpuSamplingEnabled, Mode=TwoWay}"
                                      OnContent="On"
                                      OffContent="Off" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Background="{ThemeResource CardBackgroundFillColorDefault}"
                    CornerRadius="8" Padding="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="360" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Battery history" FontWeight="SemiBold" Margin="4,0,4,8" />
                    <lvc:CartesianChart x:Name="HistoryChart"
                        Grid.Row="1"
                        Series="{x:Bind ViewModel.MainChartSeries}"
                        XAxes="{x:Bind ViewModel.TimeAxes}"
                        YAxes="{x:Bind ViewModel.PowerYAxes}"
                        ZoomMode="X"
                        PointerEntered="HistoryChart_PointerEntered"
                        PointerExited="HistoryChart_PointerExited"
                        Unloaded="HistoryChart_Unloaded" />
                </Grid>
            </Border>

            <Border Background="{ThemeResource CardBackgroundFillColorDefault}"
                    CornerRadius="8" Padding="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="320" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Top 20 processes" FontWeight="SemiBold" Margin="4,0,4,8" />

                    <Grid Grid.Row="1" ColumnSpacing="8" Padding="4,2"
                          Background="{ThemeResource CardBackgroundFillColorSecondary}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="50" />
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="70" />
                            <ColumnDefinition Width="70" />
                            <ColumnDefinition Width="70" />
                            <ColumnDefinition Width="70" />
                            <ColumnDefinition Width="70" />
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Rank" FontWeight="SemiBold" FontSize="11" />
                        <TextBlock Grid.Column="1" Text="Name" FontWeight="SemiBold" FontSize="11" />
                        <TextBlock Grid.Column="2" Text="Score" FontWeight="SemiBold" FontSize="11" />
                        <TextBlock Grid.Column="3" Text="Avg CPU" FontWeight="SemiBold" FontSize="11" />
                        <TextBlock Grid.Column="4" Text="Max CPU" FontWeight="SemiBold" FontSize="11" />
                        <TextBlock Grid.Column="5" Text="Avg GPU" FontWeight="SemiBold" FontSize="11" />
                        <TextBlock Grid.Column="6" Text="Max GPU" FontWeight="SemiBold" FontSize="11" />
                        <TextBlock Grid.Column="7" Text="Disk MB" FontWeight="SemiBold" FontSize="11" />
                        <TextBlock Grid.Column="8" Text="FG min" FontWeight="SemiBold" FontSize="11"
                                   ToolTipService.ToolTip="Foreground minutes — samples × sampling interval; sub-interval window flicker not reflected" />
                        <TextBlock Grid.Column="9" Text="BG min" FontWeight="SemiBold" FontSize="11"
                                   ToolTipService.ToolTip="Background minutes — samples × sampling interval; sub-interval window flicker not reflected" />
                        <TextBlock Grid.Column="10" Text="Reason" FontWeight="SemiBold" FontSize="11" />
                    </Grid>

                    <ListView Grid.Row="2"
                              ItemsSource="{x:Bind ViewModel.ProcessRows}"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0" />
                                <Setter Property="MinHeight" Value="0" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnSpacing="8" Padding="4,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="50" />
                                        <ColumnDefinition Width="180" />
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Rank}" FontSize="12" />
                                    <TextBlock Grid.Column="1" Text="{Binding ProcessName}"
                                               TextTrimming="CharacterEllipsis" FontSize="12" />
                                    <TextBlock Grid.Column="2" Text="{Binding ScoreText}"
                                               HorizontalAlignment="Right" FontSize="12" />
                                    <TextBlock Grid.Column="3" Text="{Binding AvgCpuText}"
                                               HorizontalAlignment="Right" FontSize="12" />
                                    <TextBlock Grid.Column="4" Text="{Binding MaxCpuText}"
                                               HorizontalAlignment="Right" FontSize="12" />
                                    <TextBlock Grid.Column="5" Text="{Binding AvgGpuText}"
                                               HorizontalAlignment="Right" FontSize="12" />
                                    <TextBlock Grid.Column="6" Text="{Binding MaxGpuText}"
                                               HorizontalAlignment="Right" FontSize="12" />
                                    <TextBlock Grid.Column="7" Text="{Binding DiskMbText}"
                                               HorizontalAlignment="Right" FontSize="12" />
                                    <TextBlock Grid.Column="8" Text="{Binding ForegroundMinutesText}"
                                               HorizontalAlignment="Right" FontSize="12" />
                                    <TextBlock Grid.Column="9" Text="{Binding BackgroundMinutesText}"
                                               HorizontalAlignment="Right" FontSize="12" />
                                    <TextBlock Grid.Column="10" Text="{Binding ReasonText}"
                                               TextTrimming="CharacterEllipsis" FontSize="12" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <Border Background="{ThemeResource CardBackgroundFillColorDefault}"
                    CornerRadius="8" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Data Sources" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <ItemsControl Grid.Row="1"
                                  ItemsSource="{x:Bind ViewModel.SourceStatusRows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnSpacing="12" Padding="2,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200" />
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding SourceName}" FontSize="12" />
                                    <TextBlock Grid.Column="1" Text="{Binding Status}"
                                               Foreground="{Binding Status, Converter={StaticResource StatusToBrushConverter}}" FontSize="12" />
                                    <TextBlock Grid.Column="2" Text="{Binding Details}"
                                               TextTrimming="CharacterEllipsis" FontSize="12"
                                               Foreground="{ThemeResource TextFillColorSecondary}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
