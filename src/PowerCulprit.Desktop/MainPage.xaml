<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="PowerCulprit.Desktop.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:PowerCulprit.Desktop.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:PowerCulprit.Desktop.ViewModels"
    mc:Ignorable="d">

    <Page.Resources>
        <vm:BoolToInverseConverter x:Key="BoolToInverseConverter" />
        <vm:StatusToBrushConverter x:Key="StatusToBrushConverter" />
    </Page.Resources>

    <ScrollViewer x:Name="RootScrollViewer"
                  Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
                  VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="{StaticResource PageContentMargin}" Spacing="16">

            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Spacing="4">
                    <TextBlock Text="PowerCulprit"
                               Style="{StaticResource DashboardTitleTextBlockStyle}" />
                    <TextBlock Text="Battery drain analysis dashboard"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="8"
                            VerticalAlignment="Center">
                    <Border Style="{StaticResource StatusPillBorderStyle}"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="Sampling"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.SamplingStatusText, Mode=OneWay}"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>

                    <Button Command="{x:Bind ViewModel.StartMonitoringCommand}"
                            IsEnabled="{x:Bind ViewModel.IsRunning, Mode=OneWay, Converter={StaticResource BoolToInverseConverter}}"
                            Style="{StaticResource AccentButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon FontSize="14" Glyph="&#xE768;" />
                            <TextBlock Text="Start" />
                        </StackPanel>
                    </Button>

                    <Button Command="{x:Bind ViewModel.StopMonitoringCommand}"
                            IsEnabled="{x:Bind ViewModel.IsRunning, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon FontSize="14" Glyph="&#xE71A;" />
                            <TextBlock Text="Stop" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <Border Style="{StaticResource DashboardCardStyle}"
                    Padding="8">
                <CommandBar Background="Transparent"
                            DefaultLabelPosition="Right"
                            IsDynamicOverflowEnabled="True">
                    <AppBarButton Command="{x:Bind ViewModel.RefreshHistoryCommand}"
                                  IsEnabled="{x:Bind ViewModel.IsHistoryLoading, Mode=OneWay, Converter={StaticResource BoolToInverseConverter}}"
                                  Label="Refresh">
                        <AppBarButton.Icon>
                            <SymbolIcon Symbol="Refresh" />
                        </AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarButton Command="{x:Bind ViewModel.LatestCycleCommand}"
                                  IsEnabled="{x:Bind ViewModel.IsHistoryLoading, Mode=OneWay, Converter={StaticResource BoolToInverseConverter}}"
                                  Label="Latest Cycle">
                        <AppBarButton.Icon>
                            <SymbolIcon Symbol="Calendar" />
                        </AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarButton Command="{x:Bind ViewModel.Last6HoursCommand}"
                                  IsEnabled="{x:Bind ViewModel.IsHistoryLoading, Mode=OneWay, Converter={StaticResource BoolToInverseConverter}}"
                                  Label="Last 6h">
                        <AppBarButton.Icon>
                            <SymbolIcon Symbol="Clock" />
                        </AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarButton Command="{x:Bind ViewModel.ExportCsvCommand}"
                                  Label="Export CSV">
                        <AppBarButton.Icon>
                            <SymbolIcon Symbol="Download" />
                        </AppBarButton.Icon>
                    </AppBarButton>

                    <CommandBar.Content>
                        <StackPanel Orientation="Horizontal"
                                    Spacing="16"
                                    VerticalAlignment="Center">
                            <ToggleSwitch Header="GPU Engine"
                                          IsOn="{x:Bind ViewModel.IsGpuSamplingEnabled, Mode=TwoWay}"
                                          OffContent="Off"
                                          OnContent="On" />
                            <TextBlock Text="{x:Bind ViewModel.ErrorText, Mode=OneWay}"
                                       Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                       MaxWidth="420"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </CommandBar.Content>

                    <CommandBar.SecondaryCommands>
                        <AppBarButton Click="ClearHistoryButton_Click"
                                      IsEnabled="{x:Bind ViewModel.IsHistoryLoading, Mode=OneWay, Converter={StaticResource BoolToInverseConverter}}"
                                      Label="Clear History">
                            <AppBarButton.Icon>
                                <SymbolIcon Symbol="Delete" />
                            </AppBarButton.Icon>
                        </AppBarButton>
                    </CommandBar.SecondaryCommands>
                </CommandBar>
            </Border>

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0.7*" />
                    <ColumnDefinition Width="1.35*" />
                    <ColumnDefinition Width="1.6*" />
                    <ColumnDefinition Width="1.75*" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource DashboardCompactCardStyle}">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Power"
                                   Style="{StaticResource MetricLabelTextBlockStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.AcStatusText, Mode=OneWay}"
                                   Style="{StaticResource MetricValueTextBlockStyle}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1"
                        Style="{StaticResource DashboardCompactCardStyle}">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Battery drop"
                                   Style="{StaticResource MetricLabelTextBlockStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.BatteryPercentText, Mode=OneWay}"
                                   Style="{StaticResource MetricValueTextBlockStyle}"
                                   ToolTipService.ToolTip="{x:Bind ViewModel.BatteryPercentText, Mode=OneWay}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2"
                        Style="{StaticResource DashboardCompactCardStyle}">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Energy used"
                                   Style="{StaticResource MetricLabelTextBlockStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.DischargeRateText, Mode=OneWay}"
                                   Style="{StaticResource MetricValueTextBlockStyle}"
                                   ToolTipService.ToolTip="{x:Bind ViewModel.DischargeRateText, Mode=OneWay}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="3"
                        Style="{StaticResource DashboardCompactCardStyle}">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Range"
                                   Style="{StaticResource MetricLabelTextBlockStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.SelectedRangeText, Mode=OneWay}"
                                   Style="{StaticResource MetricValueTextBlockStyle}"
                                   ToolTipService.ToolTip="{x:Bind ViewModel.SelectedRangeText, Mode=OneWay}" />
                    </StackPanel>
                </Border>
            </Grid>

            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="360" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource DashboardCardStyle}">
                    <Grid RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="360" />
                        </Grid.RowDefinitions>

                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Battery history"
                                       Style="{StaticResource SectionTitleTextBlockStyle}" />
                            <TextBlock Grid.Column="1"
                                       Text="{x:Bind ViewModel.HistoryStatusText, Mode=OneWay}"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       MaxWidth="360"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Top" />
                        </Grid>

                        <controls:PowerHistoryChart x:Name="HistoryChart"
                                                    Grid.Row="1"
                                                    DischargeAxisMax="{x:Bind ViewModel.ChartDischargeAxisMax, Mode=OneWay}"
                                                    HistoryFromUtc="{x:Bind ViewModel.ChartHistoryFromUtc, Mode=OneWay}"
                                                    HistoryToUtc="{x:Bind ViewModel.ChartHistoryToUtc, Mode=OneWay}"
                                                    PointerEntered="HistoryChart_PointerEntered"
                                                    PointerExited="HistoryChart_PointerExited"
                                                    Samples="{x:Bind ViewModel.ChartSamples, Mode=OneWay}"
                                                    Unloaded="HistoryChart_Unloaded"
                                                    VisibleFromUtc="{x:Bind ViewModel.ChartVisibleFromUtc, Mode=OneWay}"
                                                    VisibleRangeChanged="HistoryChart_VisibleRangeChanged"
                                                    VisibleToUtc="{x:Bind ViewModel.ChartVisibleToUtc, Mode=OneWay}" />
                    </Grid>
                </Border>

                <StackPanel Grid.Column="1" Spacing="16">
                    <Border Style="{StaticResource DashboardCardStyle}">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Cycle"
                                       Style="{StaticResource SectionTitleTextBlockStyle}" />
                            <ComboBox HorizontalAlignment="Stretch"
                                      DisplayMemberPath="Label"
                                      ItemsSource="{x:Bind ViewModel.CycleRows, Mode=OneWay}"
                                      PlaceholderText="No cycles"
                                      SelectedItem="{x:Bind ViewModel.SelectedCycleRow, Mode=TwoWay}" />
                            <TextBlock Text="{x:Bind ViewModel.CycleStatusText, Mode=OneWay}"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTipService.ToolTip="{x:Bind ViewModel.CycleStatusText, Mode=OneWay}" />
                            <TextBlock Text="{x:Bind ViewModel.AnalysisStatusText, Mode=OneWay}"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTipService.ToolTip="{x:Bind ViewModel.AnalysisStatusText, Mode=OneWay}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource DashboardCardStyle}">
                        <Grid RowSpacing="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Text="Data sources"
                                       Style="{StaticResource SectionTitleTextBlockStyle}" />

                            <ListView Grid.Row="1"
                                      MaxHeight="210"
                                      ItemsSource="{x:Bind ViewModel.SourceStatusRows}"
                                      SelectionMode="None">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="Margin" Value="0,0,0,2" />
                                        <Setter Property="MinHeight" Value="0" />
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnSpacing="8" Padding="4,5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="10" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Ellipse Width="8"
                                                     Height="8"
                                                     Fill="{Binding Status, Converter={StaticResource StatusToBrushConverter}}"
                                                     VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding SourceName}"
                                                           Style="{StaticResource TableCellTextBlockStyle}" />
                                                <TextBlock Text="{Binding Details}"
                                                           Style="{StaticResource CaptionTextBlockStyle}"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTipService.ToolTip="{Binding Details}" />
                                            </StackPanel>
                                            <Border Grid.Column="2"
                                                    Style="{StaticResource StatusPillBorderStyle}"
                                                    VerticalAlignment="Top">
                                                <TextBlock Text="{Binding Status}"
                                                           Style="{StaticResource CaptionTextBlockStyle}"
                                                           Foreground="{Binding Status, Converter={StaticResource StatusToBrushConverter}}" />
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Border>
                </StackPanel>
            </Grid>

            <Border Style="{StaticResource DashboardCardStyle}">
                <Grid RowSpacing="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="320" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="Top 20 processes"
                               Style="{StaticResource SectionTitleTextBlockStyle}" />

                    <Border Grid.Row="1"
                            Style="{StaticResource TableHeaderBorderStyle}">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="44" />
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="72" />
                                <ColumnDefinition Width="72" />
                                <ColumnDefinition Width="72" />
                                <ColumnDefinition Width="72" />
                                <ColumnDefinition Width="72" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="76" />
                                <ColumnDefinition Width="76" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Rank" Style="{StaticResource TableHeaderTextBlockStyle}" />
                            <TextBlock Grid.Column="1" Text="Name" Style="{StaticResource TableHeaderTextBlockStyle}" />
                            <TextBlock Grid.Column="2" Text="Score" HorizontalAlignment="Right" Style="{StaticResource TableHeaderTextBlockStyle}" />
                            <TextBlock Grid.Column="3" Text="Avg CPU" HorizontalAlignment="Right" Style="{StaticResource TableHeaderTextBlockStyle}" />
                            <TextBlock Grid.Column="4" Text="Max CPU" HorizontalAlignment="Right" Style="{StaticResource TableHeaderTextBlockStyle}" />
                            <TextBlock Grid.Column="5" Text="Avg GPU" HorizontalAlignment="Right" Style="{StaticResource TableHeaderTextBlockStyle}" />
                            <TextBlock Grid.Column="6" Text="Max GPU" HorizontalAlignment="Right" Style="{StaticResource TableHeaderTextBlockStyle}" />
                            <TextBlock Grid.Column="7" Text="Disk MB" HorizontalAlignment="Right" Style="{StaticResource TableHeaderTextBlockStyle}" />
                            <TextBlock Grid.Column="8"
                                       Text="FG min"
                                       HorizontalAlignment="Right"
                                       Style="{StaticResource TableHeaderTextBlockStyle}"
                                       ToolTipService.ToolTip="Foreground minutes - samples x sampling interval; sub-interval window flicker not reflected" />
                            <TextBlock Grid.Column="9"
                                       Text="BG min"
                                       HorizontalAlignment="Right"
                                       Style="{StaticResource TableHeaderTextBlockStyle}"
                                       ToolTipService.ToolTip="Background minutes - samples x sampling interval; sub-interval window flicker not reflected" />
                            <TextBlock Grid.Column="10" Text="Reason" Style="{StaticResource TableHeaderTextBlockStyle}" />
                        </Grid>
                    </Border>

                    <ListView Grid.Row="2"
                              ItemsSource="{x:Bind ViewModel.ProcessRows}"
                              SelectionMode="None"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0" />
                                <Setter Property="MinHeight" Value="0" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="0,0,0,1">
                                    <Grid ColumnSpacing="8" Padding="{StaticResource TableCellPadding}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="44" />
                                            <ColumnDefinition Width="180" />
                                            <ColumnDefinition Width="72" />
                                            <ColumnDefinition Width="72" />
                                            <ColumnDefinition Width="72" />
                                            <ColumnDefinition Width="72" />
                                            <ColumnDefinition Width="72" />
                                            <ColumnDefinition Width="80" />
                                            <ColumnDefinition Width="76" />
                                            <ColumnDefinition Width="76" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Rank}" Style="{StaticResource TableCellTextBlockStyle}" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding ProcessName}"
                                                   Style="{StaticResource TableCellTextBlockStyle}"
                                                   ToolTipService.ToolTip="{Binding ProcessName}" />
                                        <TextBlock Grid.Column="2" Text="{Binding ScoreText}" HorizontalAlignment="Right" Style="{StaticResource TableCellTextBlockStyle}" />
                                        <TextBlock Grid.Column="3" Text="{Binding AvgCpuText}" HorizontalAlignment="Right" Style="{StaticResource TableCellTextBlockStyle}" />
                                        <TextBlock Grid.Column="4" Text="{Binding MaxCpuText}" HorizontalAlignment="Right" Style="{StaticResource TableCellTextBlockStyle}" />
                                        <TextBlock Grid.Column="5" Text="{Binding AvgGpuText}" HorizontalAlignment="Right" Style="{StaticResource TableCellTextBlockStyle}" />
                                        <TextBlock Grid.Column="6" Text="{Binding MaxGpuText}" HorizontalAlignment="Right" Style="{StaticResource TableCellTextBlockStyle}" />
                                        <TextBlock Grid.Column="7" Text="{Binding DiskMbText}" HorizontalAlignment="Right" Style="{StaticResource TableCellTextBlockStyle}" />
                                        <TextBlock Grid.Column="8" Text="{Binding ForegroundMinutesText}" HorizontalAlignment="Right" Style="{StaticResource TableCellTextBlockStyle}" />
                                        <TextBlock Grid.Column="9" Text="{Binding BackgroundMinutesText}" HorizontalAlignment="Right" Style="{StaticResource TableCellTextBlockStyle}" />
                                        <TextBlock Grid.Column="10"
                                                   Text="{Binding ReasonText}"
                                                   Style="{StaticResource TableCellTextBlockStyle}"
                                                   ToolTipService.ToolTip="{Binding ReasonText}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
