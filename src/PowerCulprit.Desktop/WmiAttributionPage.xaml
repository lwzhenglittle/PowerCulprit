<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="PowerCulprit.Desktop.WmiAttributionPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:PowerCulprit.Desktop.ViewModels"
    NavigationCacheMode="Enabled"
    mc:Ignorable="d">

    <Page.Resources>
        <vm:BoolToInverseConverter x:Key="BoolToInverseConverter" />
        <vm:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </Page.Resources>

    <ScrollViewer Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
                  HorizontalScrollBarVisibility="Auto"
                  VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="{StaticResource PageContentMargin}" Spacing="16">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Spacing="4">
                    <TextBlock Text="WMI Activity"
                               Style="{StaticResource DashboardTitleTextBlockStyle}" />
                    <TextBlock Text="Caller attribution for winmgmt / wmiprvse activity from the Windows WMI-Activity Operational event log. This identifies WMI client processes, not internal call stacks."
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="WrapWholeWords" />
                </StackPanel>

                <Border Grid.Column="1"
                        Style="{StaticResource StatusPillBorderStyle}"
                        VerticalAlignment="Center">
                    <TextBlock Text="EventLog ClientProcessId"
                               Style="{StaticResource CaptionTextBlockStyle}" />
                </Border>
            </Grid>

            <Border Style="{StaticResource DashboardCardStyle}"
                    Padding="8">
                <CommandBar Background="Transparent"
                            DefaultLabelPosition="Right"
                            IsDynamicOverflowEnabled="True">
                    <AppBarButton Command="{x:Bind ViewModel.RefreshCommand}"
                                  IsEnabled="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToInverseConverter}}"
                                  Label="Refresh">
                        <AppBarButton.Icon>
                            <SymbolIcon Symbol="Refresh" />
                        </AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarButton Command="{x:Bind ViewModel.LatestCycleCommand}"
                                  IsEnabled="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToInverseConverter}}"
                                  Label="Latest Cycle">
                        <AppBarButton.Icon>
                            <SymbolIcon Symbol="Calendar" />
                        </AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarButton Command="{x:Bind ViewModel.Last6HoursCommand}"
                                  IsEnabled="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToInverseConverter}}"
                                  Label="Last 6h">
                        <AppBarButton.Icon>
                            <SymbolIcon Symbol="Clock" />
                        </AppBarButton.Icon>
                    </AppBarButton>
                    <CommandBar.Content>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <ProgressRing Width="18"
                                          Height="18"
                                          IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                                          Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                            <InfoBar IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                                     IsClosable="False"
                                     Severity="Error"
                                     Message="{x:Bind ViewModel.ErrorText, Mode=OneWay}"
                                     MaxWidth="520" />
                        </StackPanel>
                    </CommandBar.Content>
                </CommandBar>
            </Border>

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource DashboardCompactCardStyle}">
                    <StackPanel Spacing="6">
                        <TextBlock Text="WMI calls" Style="{StaticResource MetricLabelTextBlockStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.TotalCallsText, Mode=OneWay}" Style="{StaticResource MetricValueTextBlockStyle}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource DashboardCompactCardStyle}">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Callers" Style="{StaticResource MetricLabelTextBlockStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.CallerCountText, Mode=OneWay}" Style="{StaticResource MetricValueTextBlockStyle}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource DashboardCompactCardStyle}">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Failures" Style="{StaticResource MetricLabelTextBlockStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.FailureCountText, Mode=OneWay}" Style="{StaticResource MetricValueTextBlockStyle}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="3" Style="{StaticResource DashboardCompactCardStyle}">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Top caller" Style="{StaticResource MetricLabelTextBlockStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.TopCallerText, Mode=OneWay}" Style="{StaticResource MetricValueTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource DashboardCardStyle}"
                    MinWidth="900">
                <StackPanel Spacing="10">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="WMI callers"
                                   Style="{StaticResource SectionTitleTextBlockStyle}" />
                        <TextBlock Grid.Column="1"
                                   Text="{x:Bind ViewModel.SelectedRangeText, Mode=OneWay}"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Grid>

                    <Border Style="{StaticResource TableHeaderBorderStyle}">
                        <Grid ColumnSpacing="8" Padding="{StaticResource TableCellPadding}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="44" />
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="3*" />
                                <ColumnDefinition Width="2*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="#" Style="{StaticResource TableHeaderTextBlockStyle}" />
                            <TextBlock Grid.Column="1" Text="Process" Style="{StaticResource TableHeaderTextBlockStyle}" />
                            <TextBlock Grid.Column="2" Text="PID" Style="{StaticResource TableHeaderTextBlockStyle}" />
                            <TextBlock Grid.Column="3" Text="Calls" Style="{StaticResource TableHeaderTextBlockStyle}" />
                            <TextBlock Grid.Column="4" Text="Failures" Style="{StaticResource TableHeaderTextBlockStyle}" />
                            <TextBlock Grid.Column="5" Text="Unique" Style="{StaticResource TableHeaderTextBlockStyle}" />
                            <TextBlock Grid.Column="6" Text="First" Style="{StaticResource TableHeaderTextBlockStyle}" />
                            <TextBlock Grid.Column="7" Text="Last" Style="{StaticResource TableHeaderTextBlockStyle}" />
                            <TextBlock Grid.Column="8" Text="Last operation" Style="{StaticResource TableHeaderTextBlockStyle}" />
                            <TextBlock Grid.Column="9" Text="Result" Style="{StaticResource TableHeaderTextBlockStyle}" />
                        </Grid>
                    </Border>

                    <ListView ItemsSource="{x:Bind ViewModel.CallerRows, Mode=OneWay}"
                              MinWidth="900"
                              MaxHeight="520"
                              SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:WmiCallerRow">
                                <Grid ColumnSpacing="8" Padding="{StaticResource TableCellPadding}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="44" />
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="3*" />
                                        <ColumnDefinition Width="2*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind Rank}" Style="{StaticResource TableCellTextBlockStyle}" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind ProcessText}" Style="{StaticResource TableCellTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind PidText}" Style="{StaticResource TableCellTextBlockStyle}" />
                                    <TextBlock Grid.Column="3" Text="{x:Bind CallCountText}" Style="{StaticResource TableCellTextBlockStyle}" />
                                    <TextBlock Grid.Column="4" Text="{x:Bind FailureCountText}" Style="{StaticResource TableCellTextBlockStyle}" />
                                    <TextBlock Grid.Column="5" Text="{x:Bind UniqueOperationCountText}" Style="{StaticResource TableCellTextBlockStyle}" />
                                    <TextBlock Grid.Column="6" Text="{x:Bind FirstSeenText}" Style="{StaticResource TableCellTextBlockStyle}" />
                                    <TextBlock Grid.Column="7" Text="{x:Bind LastSeenText}" Style="{StaticResource TableCellTextBlockStyle}" />
                                    <TextBlock Grid.Column="8" Text="{x:Bind LastOperationText}" Style="{StaticResource TableCellTextBlockStyle}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind LastOperationText}" />
                                    <TextBlock Grid.Column="9" Text="{x:Bind LastResultText}" Style="{StaticResource TableCellTextBlockStyle}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind LastResultText}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <TextBlock Text="No WMI activity in the selected range."
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Visibility="{x:Bind ViewModel.HasCallerRows, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}" />

                    <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="WrapWholeWords" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
