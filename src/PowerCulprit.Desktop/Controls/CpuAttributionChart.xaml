<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="PowerCulprit.Desktop.Controls.CpuAttributionChart"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:canvas="using:Microsoft.Graphics.Canvas.UI.Xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <canvas:CanvasControl x:Name="ChartCanvas"
                          AutomationProperties.Name="CPU attribution chart"
                          AutomationProperties.HelpText="Shows battery, energy, CPU power, load and clock history. Use mouse wheel to zoom, drag to pan, and double-click to reset."
                          ClearColor="Transparent"
                          CreateResources="ChartCanvas_CreateResources"
                          DoubleTapped="ChartCanvas_DoubleTapped"
                          Draw="ChartCanvas_Draw"
                          PointerCanceled="ChartCanvas_PointerCanceled"
                          PointerCaptureLost="ChartCanvas_PointerCaptureLost"
                          PointerEntered="ChartCanvas_PointerEntered"
                          PointerExited="ChartCanvas_PointerExited"
                          PointerMoved="ChartCanvas_PointerMoved"
                          PointerPressed="ChartCanvas_PointerPressed"
                          PointerReleased="ChartCanvas_PointerReleased"
                          PointerWheelChanged="ChartCanvas_PointerWheelChanged"
                          SizeChanged="ChartCanvas_SizeChanged"
                          Unloaded="ChartCanvas_Unloaded" />
</UserControl>
