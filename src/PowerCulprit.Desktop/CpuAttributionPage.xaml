<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="PowerCulprit.Desktop.CpuAttributionPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:PowerCulprit.Desktop.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:PowerCulprit.Desktop.ViewModels"
    mc:Ignorable="d">

    <Page.Resources>
        <vm:BoolToInverseConverter x:Key="BoolToInverseConverter" />
    </Page.Resources>

    <ScrollViewer x:Name="RootScrollViewer"
                  Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
                  VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="{StaticResource PageContentMargin}" Spacing="16">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Spacing="4">
                    <TextBlock Text="CPU Attribution"
                               Style="{StaticResource DashboardTitleTextBlockStyle}" />
                    <TextBlock Text="Battery drain compared with CPU clock, load, and package power. Correlation only; not a per-process wattmeter."
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <Border Grid.Column="1"
                        Style="{StaticResource StatusPillBorderStyle}"
                        VerticalAlignment="Center">
                    <TextBlock Text="LHM CPU sensors"
                               Style="{StaticResource CaptionTextBlockStyle}" />
                </Border>
            </Grid>

            <Border Style="{StaticResource DashboardCardStyle}"
                    Padding="8">
                <CommandBar Background="Transparent"
                            DefaultLabelPosition="Right"
                            IsDynamicOverflowEnabled="True">
                    <AppBarButton Command="{x:Bind ViewModel.RefreshCommand}"
                                  IsEnabled="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToInverseConverter}}"
                                  Label="Refresh">
                        <AppBarButton.Icon>
                            <SymbolIcon Symbol="Refresh" />
                        </AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarButton Command="{x:Bind ViewModel.LatestCycleCommand}"
                                  IsEnabled="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToInverseConverter}}"
                                  Label="Latest Cycle">
                        <AppBarButton.Icon>
                            <SymbolIcon Symbol="Calendar" />
                        </AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarButton Command="{x:Bind ViewModel.Last6HoursCommand}"
                                  IsEnabled="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToInverseConverter}}"
                                  Label="Last 6h">
                        <AppBarButton.Icon>
                            <SymbolIcon Symbol="Clock" />
                        </AppBarButton.Icon>
                    </AppBarButton>
                    <CommandBar.Content>
                        <TextBlock Text="{x:Bind ViewModel.ErrorText, Mode=OneWay}"
                                   Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                   MaxWidth="520"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" />
                    </CommandBar.Content>
                </CommandBar>
            </Border>

            <Grid ColumnSpacing="12" RowSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Style="{StaticResource DashboardCompactCardStyle}">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Battery drop" Style="{StaticResource MetricLabelTextBlockStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.BatteryDropText, Mode=OneWay}" Style="{StaticResource MetricValueTextBlockStyle}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource DashboardCompactCardStyle}">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Energy used" Style="{StaticResource MetricLabelTextBlockStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.EnergyUsedText, Mode=OneWay}" Style="{StaticResource MetricValueTextBlockStyle}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource DashboardCompactCardStyle}">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Range" Style="{StaticResource MetricLabelTextBlockStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.SelectedRangeText, Mode=OneWay}" Style="{StaticResource MetricValueTextBlockStyle}" ToolTipService.ToolTip="{x:Bind ViewModel.SelectedRangeText, Mode=OneWay}" />
                    </StackPanel>
                </Border>
                <Border Grid.Row="1" Style="{StaticResource DashboardCompactCardStyle}">
                    <StackPanel Spacing="6">
                        <TextBlock Text="CPU clock" Style="{StaticResource MetricLabelTextBlockStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.CpuClockText, Mode=OneWay}" Style="{StaticResource MetricValueTextBlockStyle}" ToolTipService.ToolTip="{x:Bind ViewModel.CpuClockText, Mode=OneWay}" />
                    </StackPanel>
                </Border>
                <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource DashboardCompactCardStyle}">
                    <StackPanel Spacing="6">
                        <TextBlock Text="CPU load" Style="{StaticResource MetricLabelTextBlockStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.CpuLoadText, Mode=OneWay}" Style="{StaticResource MetricValueTextBlockStyle}" />
                    </StackPanel>
                </Border>
                <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource DashboardCompactCardStyle}">
                    <StackPanel Spacing="6">
                        <TextBlock Text="CPU package" Style="{StaticResource MetricLabelTextBlockStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.CpuPowerText, Mode=OneWay}" Style="{StaticResource MetricValueTextBlockStyle}" ToolTipService.ToolTip="{x:Bind ViewModel.CpuPowerText, Mode=OneWay}" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource DashboardCardStyle}">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="460" />
                    </Grid.RowDefinitions>
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Battery + CPU timeline"
                                   Style="{StaticResource SectionTitleTextBlockStyle}" />
                        <TextBlock Grid.Column="1"
                                   Text="{x:Bind ViewModel.HistoryStatusText, Mode=OneWay}"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   MaxWidth="480"
                                   TextTrimming="CharacterEllipsis" />
                    </Grid>

                    <controls:CpuAttributionChart x:Name="CpuChart"
                                                  Grid.Row="1"
                                                  HistoryFromUtc="{x:Bind ViewModel.ChartHistoryFromUtc, Mode=OneWay}"
                                                  HistoryToUtc="{x:Bind ViewModel.ChartHistoryToUtc, Mode=OneWay}"
                                                  Samples="{x:Bind ViewModel.ChartSamples, Mode=OneWay}"
                                                  VisibleFromUtc="{x:Bind ViewModel.ChartVisibleFromUtc, Mode=OneWay}"
                                                  VisibleToUtc="{x:Bind ViewModel.ChartVisibleToUtc, Mode=OneWay}"
                                                  CpuPowerAxisMax="{x:Bind ViewModel.CpuPowerAxisMax, Mode=OneWay}"
                                                  CpuClockAxisMax="{x:Bind ViewModel.CpuClockAxisMax, Mode=OneWay}"
                                                  EnergyAxisMax="{x:Bind ViewModel.EnergyAxisMax, Mode=OneWay}"
                                                  PointerEntered="CpuChart_PointerEntered"
                                                  PointerExited="CpuChart_PointerExited"
                                                  Unloaded="CpuChart_Unloaded"
                                                  VisibleRangeChanged="CpuChart_VisibleRangeChanged" />
                </Grid>
            </Border>

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource DashboardCardStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Attribution summary" Style="{StaticResource SectionTitleTextBlockStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.AttributionSummaryText, Mode=OneWay}"
                                   TextWrapping="WrapWholeWords"
                                   Style="{StaticResource TableCellTextBlockStyle}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource DashboardCardStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="CPU energy + correlation" Style="{StaticResource SectionTitleTextBlockStyle}" />
                        <TextBlock Text="CPU energy" Style="{StaticResource MetricLabelTextBlockStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.CpuEnergyText, Mode=OneWay}" Style="{StaticResource MetricValueTextBlockStyle}" />
                        <TextBlock Text="CPU/discharge r" Style="{StaticResource MetricLabelTextBlockStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.CorrelationText, Mode=OneWay}" Style="{StaticResource MetricValueTextBlockStyle}" />
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
