<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Microsoft.Data.Sqlite.Core + explicit SQLitePCLRaw chain, with SourceGear.sqlite3
      providing the native amalgamation.

      The default Microsoft.Data.Sqlite package pulls in SQLitePCLRaw.bundle_e_sqlite3,
      which transitively depends on SQLitePCLRaw.lib.e_sqlite3 2.1.11 — the last released
      version of that package, deprecated and flagged for CVE-2025-6965 (GHSA-2m69-gcr7-jv3q,
      CVSS 7.2: SQLite < 3.50.2 lets aggregate term count exceed column count, allowing
      memory corruption).

      SourceGear.sqlite3 (versioned by SQLite release, currently 3.50.4.5) is the upstream-
      recommended replacement and ships the patched native amalgamation. Because we're not
      using a bundle, DatabaseManager's static ctor must call SQLitePCL.raw.SetProvider().
    -->
    <PackageReference Include="Microsoft.Data.Sqlite.Core" Version="10.0.9" />
    <PackageReference Include="SQLitePCLRaw.core" Version="3.0.3" />
    <PackageReference Include="SQLitePCLRaw.provider.e_sqlite3" Version="3.0.3" />
    <PackageReference Include="SourceGear.sqlite3" Version="3.50.4.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PowerCulprit.Core\PowerCulprit.Core.csproj" />
  </ItemGroup>

</Project>
